# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
DATABASE_URL=sqlite:///./rag_metadata.db
SEED_DEMO_DATA=false

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Providers Configuration: "groq", "gemini", "cohere", "huggingface", "openai", "mock"
PRIMARY_LLM_PROVIDER=groq

# API Keys (Provide at least one active LLM key, e.g. GROQ_API_KEY)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk_your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here

# Embedding Engine: "sentence_transformers", "cohere", "huggingface"
EMBEDDING_PROVIDER=sentence_transformers
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-m3

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SCORE_THRESHOLD=0.05
